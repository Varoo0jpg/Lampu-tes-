stem2img = {p.stem: p for p in idir.iterdir() if p.suffix.lower() in exts}

red = {c: [] for c in names}; truck_crops = []
for lf in ldir.glob("*.txt"):
    ip = stem2img.get(lf.stem)
    if ip is None: continue
    img = cv2.imread(str(ip))
    if img is None: continue
    H, W = img.shape[:2]
    for ln in lf.read_text().splitlines():
        p = ln.split()
        if len(p) < 5: continue
        c = int(float(p[0])); x, y, w, h = map(float, p[1:5])
        x1, y1 = max(0, int((x-w/2)*W)), max(0, int((y-h/2)*H))
        x2, y2 = min(W, int((x+w/2)*W)), min(H, int((y+h/2)*H))
        crop = img[y1:y2, x1:x2]
        if crop.shape[0] < 8 or crop.shape[1] < 8: continue
        hsv = cv2.cvtColor(crop, cv2.COLOR_BGR2HSV)
        hh, ss, vv = hsv[..., 0], hsv[..., 1], hsv[..., 2]
