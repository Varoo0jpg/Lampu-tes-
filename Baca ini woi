                      save=True, project=r"C:\MainMain\diag_out", name=tag, exist_ok=True, **kw)[0]
        xy = r.boxes.xyxy.cpu().numpy(); c = r.boxes.cls.cpu().numpy().astype(int); s = r.boxes.conf.cpu().numpy()
        same = diff = 0
        for i in range(len(xy)):
