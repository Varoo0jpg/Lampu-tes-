```python
import yaml, random, cv2, numpy as np
from pathlib import Path
from collections import defaultdict

Y = Path(r"C:\MainMain\SmartTraffic_Final\dataset.yaml")
cfg = yaml.safe_load(open(Y, encoding="utf-8"))
root = Path(cfg.get("path", Y.parent))
names = cfg["names"]
names = names if isinstance(names, dict) else dict(enumerate(names))
OUT = Path(r"C:\MainMain\audit_out"); OUT.mkdir(exist_ok=True)
random.seed(0)

def img_dir(split):
    p = Path(cfg[split])
    return p if p.is_absolute() else root / p

def lbl_dir(d):
    s = str(d)
    return Path(s.replace("\\images\\", "\\labels\\").replace("/images/", "/labels/"))

def read_labels(f):
    rows = []
    for ln in f.read_text().splitlines():
        p = ln.split()
        if len(p) >= 5:
            rows.append((int(float(p[0])), *map(float, p[1:5])))
    return rows

for split in ["train", "val", "test"]:
    if split not in cfg:
        continue
    idir = img_dir(split); ldir = lbl_dir(idir)
    files = list(ldir.glob("*.txt"))
    stats = defaultdict(list); imgs = defaultdict(set); total = 0
    for f in files:
        for c, x, y, w, h in read_labels(f):
            stats[c].append((w, h)); imgs[c].add(f); total += 1
    print(f"\n=== {split}: {len(files)} file label, {total} objek, "
          f"{total/max(len(files),1):.2f} objek/gambar ===")
    print(f"{'kelas':12s} {'objek':>6s} {'gambar':>6s} {'med_w':>6s} {'med_h':>6s} {'%kecil(<1%)':>12s} {'%besar(>50%)':>13s}")
    for c in sorted(names):
        a = np.array(stats[c]) if stats[c] else np.zeros((0, 2))
        if len(a) == 0:
            print(f"{names[c]:12s} {0:6d}"); continue
        area = a[:, 0] * a[:, 1]
        print(f"{names[c]:12s} {len(a):6d} {len(imgs[c]):6d} {np.median(a[:,0]):6.2f} "
              f"{np.median(a[:,1]):6.2f} {100*(area<0.01).mean():12.1f} {100*(area>0.5).mean():13.1f}")

    if split != "train":
        continue
    stem2img = {p.stem: p for p in idir.iterdir() if p.suffix.lower() in {".jpg", ".jpeg", ".png", ".bmp", ".webp"}}
    for c in sorted(names):
        cand = [f for f in imgs[c] if f.stem in stem2img]
        tiles = []
        for f in random.sample(cand, min(12, len(cand))):
            img = cv2.imread(str(stem2img[f.stem]))
            if img is None:
                continue
            H, W = img.shape[:2]
            th = max(2, W // 200)
            for cc, x, y, w, h in read_labels(f):
                if cc != c:
                    continue
                p1 = (int((x - w/2) * W), int((y - h/2) * H))
                p2 = (int((x + w/2) * W), int((y + h/2) * H))
                cv2.rectangle(img, p1, p2, (0, 255, 0), th)
            tiles.append(cv2.resize(img, (320, 240)))
        while tiles and len(tiles) < 12:
            tiles.append(np.zeros((240, 320, 3), np.uint8))
        if tiles:
            rows = [np.hstack(tiles[i:i+4]) for i in range(0, 12, 4)]
            cv2.imwrite(str(OUT / f"train_{c}_{names[c]}.jpg"), np.vstack(rows))
print("\nSelesai. Lihat folder:", OUT)
```

